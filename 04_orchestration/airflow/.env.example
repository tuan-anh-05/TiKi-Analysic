# Copy to .env in this directory. Never commit .env or the MinIO license.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-this-local-password
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_SECRET_KEY=replace-with-a-long-random-secret
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-this-db-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=tiki-lake

# Supabase PostgreSQL connection string; do not put it in source control.
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
